+    except RuntimeError as exc:
+        if _is_missing_rpc(exc):
+            return 0
+        raise
+    if isinstance(data, int):
+        return data
+    if isinstance(data, dict):
+        for val in data.values():
+            if isinstance(val, int):
+                return val
+    try:
+        return int(data or 0)
+    except (TypeError, ValueError):
+        return 0
