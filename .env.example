# Copy to .env for local dev. In production every value is a Railway service
# variable. Nothing here is ever committed with a real value.

PORT=3000

# --- Supabase (state lives in the `topup` schema on campaignintelligence) ---
# The service refuses to boot against any other project ref (guard: D6).
SUPABASE_PROJECT_REF=azpapwtnrbzywlnxxecz
SUPABASE_URL=https://azpapwtnrbzywlnxxecz.supabase.co
# Service role: reads the private list-build-transcripts bucket for build_record.
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres URL, used for `npm run migrate` and for SET LOCAL app.run_id
# inside lead-table writes (the write lock reads that setting).
DATABASE_URL=

# Who may approve a top-up, by first name, comma separated. Empty = Josh and Cayden (D92).
TOPUP_APPROVERS=

# --- MCP (/mcp) — HTTPS Streamable HTTP on Railway ---
# Public URL: https://leadtopup-production.up.railway.app/mcp
# D41: no login. Tokens are optional. Owner token still elevates to owner.
MCP_OWNER_TOKEN=
MCP_OPERATOR_TOKEN=

# --- The three servers this service calls (D99). It forks none of them. ---
# LeadPipe: every row moves through it (ingest_csv, export to the verifier).
LEADPIPE_MCP_URL=
LEADPIPE_TOKEN=
# Email Verifier Progression (MillionVerifier then No2Bounce).
VERIFIER_BASE_URL=https://verifyfall-production.up.railway.app
# Smartlead MCP on Railway (import, post-import). Only the D6 allow list is ever called.
SMARTLEAD_MCP_URL=
SMARTLEAD_TOKEN=

# --- Addresses only, so `connectors` can tell Grokbot where to attach them. Not called from here. ---
MAPS_MCP_URL=
PERMITSTACK_MCP_URL=
DOMAIN_WATERFALL_MCP_URL=
PEOPLE_WATERFALL_MCP_URL=
EMAIL_WATERFALL_MCP_URL=

# --- ICP website gate edge functions (D60). The keys are the functions' own access keys. ---
SUPABASE_FUNCTIONS_URL=https://azpapwtnrbzywlnxxecz.supabase.co/functions/v1
ICP_SITE_FETCH_KEY=
ICP_LLM_KEY=
ICP_DISCO_KEY=
ICP_JEV_MODEL=typesafe/jev-1.13

# Poll cadence and patience for the vendor jobs (LeadPipe ingest, DiscoLike, Smartlead import).
JOB_POLL_SECONDS=30
JOB_DEAD_MINUTES=90

# --- Spend rails. Defaults are the decided values (D51). ---
AUTO_SPEND_CAP_USD=0
DAILY_VENDOR_CAP_USD=25
# Minutes an over-cap card waits for a tap before the run parks.
SPEND_CARD_TIMEOUT_MINUTES=1440

# --- Verify stage ---
VERIFY_POLL_SECONDS=60
VERIFY_STALL_PERCENT=90
VERIFY_STALL_MINUTES=12
VERIFY_MIN_SPLIT_ROWS=50
# Hard ceiling: a batch with no progress at any percent for this long is also a stall.
VERIFY_DEAD_MINUTES=360
