# Copy to .env for local dev. In production every value is a Railway service
# variable. Nothing here is ever committed with a real value.

PORT=3000

# --- Supabase (state lives in the `topup` schema on campaignintelligence) ---
# The service refuses to boot against any other project ref (guard: D6).
SUPABASE_PROJECT_REF=azpapwtnrbzywlnxxecz
SUPABASE_URL=https://azpapwtnrbzywlnxxecz.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres URL, used for `npm run migrate` and for SET LOCAL app.run_id
# inside lead-table writes (the write lock reads that setting).
DATABASE_URL=

# --- Slack ---
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_OPS_CHANNEL=#topup_ops
# Per-client channel map, JSON: {"parlay":"#parlay","goliath":"#goliath"}
SLACK_CLIENT_CHANNELS={}
# Roles by Slack user id, comma separated. Owner = Josh, operator = Cayden.
SLACK_OWNER_USER_IDS=
SLACK_OPERATOR_USER_IDS=

# --- MCP (/mcp) ---
MCP_OWNER_TOKEN=
MCP_OPERATOR_TOKEN=

# --- Existing servers this service calls (HTTP). It forks none of them. ---
LEADPIPE_MCP_URL=
LEADPIPE_TOKEN=
VERIFIER_BASE_URL=https://verifyfall-production.up.railway.app
WIZARD_HEALTH_URL=

# --- Spend rails (section 3.5). Defaults are the decided values. ---
AUTO_SPEND_CAP_USD=5
DAILY_VENDOR_CAP_USD=25
# Minutes an over-cap card waits for a tap before the run parks.
SPEND_CARD_TIMEOUT_MINUTES=1440

# --- Verify stage ---
VERIFY_POLL_SECONDS=60
VERIFY_STALL_PERCENT=90
VERIFY_STALL_MINUTES=12
VERIFY_MIN_SPLIT_ROWS=50
# Hard ceiling: a batch with no progress at any percent for this long is also a stall.
VERIFY_DEAD_MINUTES=360

# --- Optional read-only vendor keys for the balance watch (rail 4). ---
# Without them the watch falls back to the verifier's credits-used counters.
MILLIONVERIFIER_API_KEY=
NO2BOUNCE_API_TOKEN=

# Pause between a failed step attempt and the next (three attempts, then the run parks).
STEP_RETRY_SECONDS=30

# --- Cron ---
WATCH_CRON=0 */6 * * *
# Daily digest in the ops channel (13:00 UTC = 8am Central). Silent when no lane changed.
DIGEST_CRON=0 13 * * *
DRY_RUN=false
